    "info": {
        "title": "HabitTrack API",
        "description": "API du projet final du cours \u00ab Tasky Web : De Flutter au Web \u00bb",
        "version": "1.0.0",
        "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
        "securitySchemes": {
            "bearer": {
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "type": "http"
            }
        },
        "schemas": {
            "RegisterDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Awa Dossou"
                    },
                    "email": {
                        "type": "string",
                        "example": "awa@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "MotDePasse2026",
                        "minLength": 8
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password"
                ]
            },
            "VerifyOtpDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "awa@example.com"
                    },
                    "code": {
                        "type": "string",
                        "example": "123456"
                    }
                },
                "required": [
                    "email",
                    "code"
                ]
            },
            "ResendOtpDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "awa@example.com"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "LoginDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "demo@habittrack.dev"
                    },
                    "password": {
                        "type": "string",
                        "example": "HabitTrack2026!"
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "RefreshDto": {
                "type": "object",
                "properties": {
                    "refresh_token": {
                        "type": "string",
                        "description": "Mode \u00ab body \u00bb uniquement. En mode cookie, le jeton est lu dans le cookie habittrack_refresh."
                    }
                }
            },
            "CreateHabitDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Lire 20 minutes",
                        "minLength": 3,
                        "maxLength": 60
                    },
                    "description": {
                        "type": "object",
                        "example": "Avant de dormir",
                        "maxLength": 500,
                        "nullable": true
                    },
                    "frequency": {
                        "type": "string",
                        "enum": [
                            "DAILY",
                            "WEEKLY"
                        ],
                        "default": "DAILY"
                    },
                    "timesPerWeek": {
                        "type": "object",
                        "example": 3,
                        "minimum": 1,
                        "maximum": 7,
                        "description": "Obligatoire si frequency = WEEKLY"
                    },
                    "color": {
                        "type": "string",
                        "enum": [
                            "indigo",
                            "emerald",
                            "amber",
                            "rose",
                            "sky",
                            "violet"
                        ],
                        "example": "indigo"
                    },
                    "startDate": {
                        "type": "string",
                        "example": "2026-09-01",
                        "description": "AAAA-MM-JJ"
                    },
                    "clientId": {
                        "type": "string",
                        "description": "Identifiant g\u00e9n\u00e9r\u00e9 par le client (UUID), pour le mode hors ligne"
                    }
                },
                "required": [
                    "name",
                    "color",
                    "startDate"
                ]
            },
            "UpdateHabitDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Lire 20 minutes",
                        "minLength": 3,
                        "maxLength": 60
                    },
                    "description": {
                        "type": "object",
                        "example": "Avant de dormir",
                        "maxLength": 500,
                        "nullable": true
                    },
                    "frequency": {
                        "type": "string",
                        "enum": [
                            "DAILY",
                            "WEEKLY"
                        ],
                        "default": "DAILY"
                    },
                    "timesPerWeek": {
                        "type": "object",
                        "example": 3,
                        "minimum": 1,
                        "maximum": 7,
                        "description": "Obligatoire si frequency = WEEKLY"
                    },
                    "color": {
                        "type": "string",
                        "enum": [
                            "indigo",
                            "emerald",
                            "amber",
                            "rose",
                            "sky",
                            "violet"
                        ],
                        "example": "indigo"
                    },
                    "startDate": {
                        "type": "string",
                        "example": "2026-09-01",
                        "description": "AAAA-MM-JJ"
                    },
                    "clientId": {
                        "type": "string",
                        "description": "Identifiant g\u00e9n\u00e9r\u00e9 par le client (UUID), pour le mode hors ligne"
                    },
                    "archived": {
                        "type": "boolean",
                        "default": false
                    }
                }
            }
        }
    }
}
