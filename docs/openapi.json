        "/checkins": {
            "get": {
                "operationId": "HabitsController_checkins",
                "parameters": [
                    {
                        "name": "from",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "example": "2026-09-01",
                            "type": "string"
                        }
                    },
                    {
                        "name": "to",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "example": "2026-09-30",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "Les jours valid\u00e9s sur une p\u00e9riode (366 jours au plus)",
                "tags": [
                    "habits"
                ]
            }
        },
        "/habits/{id}/checkins/{date}": {
            "put": {
                "operationId": "HabitsController_check",
                "parameters": [
                    {
                        "name": "id",
                        "required": true,
                        "in": "path",
                        "schema": {
