                },
                "responses": {
                    "200": {
                        "description": ""
                    }
                },
                "summary": "Obtenir un nouveau jeton d\u2019acc\u00e8s (rotation du refresh token)",
                "tags": [
                    "auth"
                ]
            }
        },
        "/auth/logout": {
            "post": {
                "operationId": "AuthController_logout",
