# Copiez ce fichier en .env pour lancer l'API sans Docker (npm run start:dev).
DATABASE_URL=postgresql://habittrack:habittrack@localhost:5432/habittrack
PORT=3001

# Secrets JWT : changez-les en production (deux secrets distincts).
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-0123456789
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Origines autorisées (HabitTrack Web en développement : Vite sur 5173, preview sur 4173).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Cookie du refresh token (mode « cookie ») : Secure exige HTTPS, donc false en local.
COOKIE_SECURE=false
COOKIE_PATH=/auth

# E-mails (Mailpit en développement : interface sur http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="HabitTrack <no-reply@habittrack.local>"

# Mettre à false pour autoriser la connexion sans vérification de l'e-mail.
AUTH_REQUIRE_VERIFIED=true
RATE_LIMIT_PER_MINUTE=120
